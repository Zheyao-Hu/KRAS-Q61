# Activate MOLINFO functionalities
MOLINFO STRUCTURE=./step3_input.pdb 

FIT_TO_TEMPLATE REFERENCE=step3_input_reference.pdb

# distance between L61-N and TYR96-OH
d1: DISTANCE ATOMS=917,1486

# angle between (35Ca->25Ca) and a-helix1 (25Ca->17Ca)
a: ANGLE ATOMS=523,365,237

uwall: UPPER_WALLS ARG=d1 AT=2.5 KAPPA=2000.0 EXP=2 EPS=1 OFFSET=0 

metad: METAD ARG=d1,a ...
 
   PACE=500 HEIGHT=1.2 BIASFACTOR=10 TEMP=310.15

   SIGMA=0.1,0.2 CALC_RCT GRID_MIN=0,-pi GRID_MAX=5.0,pi GRID_BIN=300,300 

   FILE=HILLS 
...

PRINT ARG=d1,a,metad.bias FILE=COLVAR STRIDE=10
